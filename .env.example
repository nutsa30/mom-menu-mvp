DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
JWT_SECRET="local-dev-super-secret-change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# OneSignal Web Push — get your App ID at https://onesignal.com
# Create account → New App → Web Push → copy the App ID below
NEXT_PUBLIC_ONESIGNAL_APP_ID="YOUR_ONESIGNAL_APP_ID"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Lemon Squeezy (payments) — Settings → API in your Lemon Squeezy dashboard
LEMONSQUEEZY_API_KEY="your-api-key"
LEMONSQUEEZY_STORE_ID="your-store-id"
LEMONSQUEEZY_WEBHOOK_SECRET="your-webhook-signing-secret"
LEMONSQUEEZY_RECIPE_PLAN_VARIANT_ID="variant-id-for-recipe-plan"
LEMONSQUEEZY_FULL_PLAN_VARIANT_ID="variant-id-for-full-plan"

# Quickpay (payments, GEL) — app.quickpay.ge → API გასაუალები
# NOTE: currently unreachable from the UI (see BOG block below) — left in place for reference.
QUICKPAY_API_KEY="qpk_test_..."
QUICKPAY_WEBHOOK_SECRET="your-webhook-signing-secret"
QUICKPAY_SUBSCRIPTION_GATEWAY_SLUG="fastoo_subscriptions"
QUICKPAY_RECIPE_PLAN_AMOUNT_GEL="15"
QUICKPAY_FULL_PLAN_AMOUNT_GEL="21"

# Bank of Georgia Payment Manager (payments, GEL) — bog.ge merchant portal
# https://api.bog.ge/docs/en/payments/* — Auth: client_id/client_secret via OAuth2 client_credentials.
BOG_CLIENT_ID="your-bog-client-id"
BOG_CLIENT_SECRET="your-bog-client-secret"
# Base64-encoded PEM of BOG's RSA public key, used to verify the Callback-Signature
# header on webhook deliveries (base64'd to avoid multiline .env issues).
BOG_PUBLIC_KEY="base64-encoded-PEM-public-key"
BOG_RECIPE_PLAN_AMOUNT_GEL="15"
BOG_FULL_PLAN_AMOUNT_GEL="21"
# Nominal trial-verification charge, refunded automatically once the card is saved.

CRON_SECRET="mm2026"
