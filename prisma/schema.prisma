model PushSchedule {
  id            String   @id @default("singleton")
  paused        Boolean  @default(false)
  breakfastHour Int      @default(8)
  lunchHour     Int      @default(12)
  snackHour     Int      @default(15)
  dinnerHour    Int      @default(18)
  weeklyHour    Int      @default(10)
  updatedAt     DateTime @updatedAt
}