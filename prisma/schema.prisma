// ── First Foods (6–12 months) ─────────────────────────────────────────────

model BabyIngredient {
  id           String   @id @default(cuid())
  nameKa       String
  nameEn       String
  category     String   // "vegetable" | "fruit" | "protein" | "dairy" | "grain" | "allergen"
  minAgeMonths Int      @default(6)
  imageUrl     String?
  // Common allergen (egg, dairy, peanut, tree nut, wheat, soy, fish, sesame) — flagged so the
  // UI can call out that it needs to be introduced alone and watched, same as any other new
  // food, but worth the extra emphasis given the higher reaction risk.
  isAllergen   Boolean  @default(false)
  createdAt    DateTime @default(now())

  statuses     BabyIngredientStatus[]
  suggestionLinks BabyMealSuggestionIngredient[]
}

model BabyIngredientStatus {
  id           String         @id @default(cuid())
  childId      String
  child        Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   BabyIngredient @relation(fields: [ingredientId], references: [id])

  tried        Boolean   @default(false)
  liked        Boolean?
  disliked     Boolean?
  ateWell      Boolean?
  refused      Boolean?
  allergic     Boolean   @default(false)
  comment      String?
  triedAt      DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([childId, ingredientId])
}

model BabyMealSuggestion {
  id           String   @id @default(cuid())
  titleKa      String
  titleEn      String
  minAgeMonths Int      @default(6)
  texture      String   @default("puree") // "puree" | "mashed" | "softPieces"
  createdAt    DateTime @default(now())

  ingredientLinks BabyMealSuggestionIngredient[]
  logs            BabyMealLog[]
}

model BabyMealSuggestionIngredient {
  id           String             @id @default(cuid())
  suggestionId String
  suggestion   BabyMealSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   BabyIngredient     @relation(fields: [ingredientId], references: [id])

  @@unique([suggestionId, ingredientId])
}

model BabyMealLog {
  id           String             @id @default(cuid())
  childId      String
  child        Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  suggestionId String
  suggestion   BabyMealSuggestion @relation(fields: [suggestionId], references: [id])

  ate          Boolean  @default(false)
  liked        Boolean?
  refused      Boolean?
  comment      String?
  eatenAt      DateTime @default(now())
  createdAt    DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Public homepage testimonials — submitted by logged-in users, only shown to visitors
// once an admin approves them. authorName is a snapshot at submission time so a
// testimonial survives the author later deleting their account.
model Testimonial {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  content    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Permanent record that an email address has already used its free BOG trial —
// survives account deletion so deleting and re-registering with the same email can't
// be used to farm repeat 7-day trials. Checked at registration time, independent of
// any User row's own bogTrialUsed field (which is lost when the account is deleted).
model UsedTrialEmail {
  email  String   @id
  usedAt DateTime @default(now())
}

// Holds a registration in progress — no User row is created until the emailed code is
// confirmed, so an unconfirmed signup never occupies the email address at all.
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT       // Resend's API accepted the request — NOT proof of actual delivery
  FAILED     // Resend rejected the request outright (bad address, unverified domain, rate limit, etc.)
  DELIVERED  // confirmed by Resend's own webhook — actually reached the recipient's mail server
  BOUNCED    // confirmed by Resend's own webhook — rejected by the recipient's mail server
  COMPLAINED // confirmed by Resend's own webhook — recipient marked it as spam
}

model EmailCampaign {
  id             String           @id @default(cuid())
  subject        String
  htmlContent    String
  senderEmail    String           @default("info@mommenu.ge")
  status         CampaignStatus   @default(DRAFT)
  type           String           @default("CAMPAIGN")
  audienceType   String           @default("specific")
  audienceFilter String?
  recipientCount Int              @default(0)
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  recipients     EmailRecipient[]
}

model EmailRecipient {
  id              String          @id @default(cuid())
  campaignId      String
  campaign        EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email           String
  status          RecipientStatus @default(PENDING)
  // Resend's own id for this specific send (the `data.id` in its send response) — the
  // Resend webhook's delivered/bounced/complained events key off this, not our own id, so
  // it's how those events get matched back to the right recipient row.
  resendMessageId String?         @unique
  // The actual Resend-reported reason when status is FAILED (e.g. "domain not verified",
  // rate limited) — without this there was no way to tell WHY a send failed.
  errorMessage    String?
  sentAt          DateTime?
  // Last time a webhook event updated this row (delivered/bounced/complained) — distinct
  // from sentAt, which only ever reflects the initial send attempt.
  lastEventAt     DateTime?
  createdAt       DateTime        @default(now())
}

model SeoSettings {
  id                   String   @id @default("singleton")
  googleVerification   String   @default("")
  gaId                 String   @default("")
  gtmId                String   @default("")
  updatedAt            DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subjectKa String
  subjectEn String
  bodyKa    String
  bodyEn    String
  // Admin on/off switch for periodic/broadcast templates (weekly menu, subscription
  // expiring, birthday wish, new blog) — lib/email.ts's send functions for those keys
  // check this and silently skip the send when false, so turning a reminder off in
  // Email Center → Templates takes effect immediately, no code change/deploy needed.
  // Critical transactional templates (welcome, password reset, email verify, etc.)
  // ignore this field entirely — those can't be switched off from the admin UI.
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSettings {
  id             String   @id @default("singleton")
  titleKa        String   @default("გვესაუბრე")
  titleEn        String   @default("Talk to us")
  subtitleKa     String   @default("ვმუშაობთ, რომ MomMenu ყოველდღე უკეთესი გახდეს. შენი ხმა მნიშვნელოვანია.")
  subtitleEn     String   @default("We work every day to make MomMenu better. Your voice matters.")
  introKa        String   @default("კითხვა გაქვს? წინადადება? ჩაგვწერე — ვუპასუხებთ 24 საათის განმავლობაში.")
  introEn        String   @default("Have a question or suggestion? Write to us — we respond within 24 hours.")
  email          String   @default("info@mommenu.ge")
  responseTimeKa String   @default("24 საათის განმავლობაში")
  responseTimeEn String   @default("Within 24 hours")
  workingHoursKa String   @default("ორშ — პარ, 10:00 – 18:00")
  workingHoursEn String   @default("Mon – Fri, 10:00 – 18:00")
  updatedAt      DateTime @updatedAt
}

model PushTemplate {
  id        Int      @id @default(autoincrement())
  mealType  String   // breakfast | lunch | snack | dinner | weekly
  title     String
  body      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
