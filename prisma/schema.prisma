  plan1Feature2Ka    String @default("✔ ბლოგები, სტატიები და კვებითი რჩევები")
  plan1Feature2En    String @default("✔ Blog posts, articles & nutrition tips")
  plan1Feature3Ka    String @default("✔ საიტის ყველა კონტენტი შეუზღუდავად")
  plan1Feature3En    String @default("✔ Unlimited access to all site content")
  plan2NameKa        String @default("სრული პაკეტი")
  plan2NameEn        String @default("Full Package")
  plan2Price         Int    @default(30)
  plan2SalePrice     Int?
  plan2Feature1Ka    String @default("✔ ყველაფერი, რაც 15₾ გეგმაშია")
  plan2Feature1En    String @default("✔ Everything included in the 15₾ plan")
  plan2Feature2Ka    String @default("✔ შვილის პირადი პროფილი — ასაკი, ალერგენები და გემოვნება")
  plan2Feature2En    String @default("✔ Child profile — age, allergies & food preferences")
  plan2Feature3Ka    String @default("✔ კვირის კვების გეგმა და ავტომატური საყიდლების სია")
  plan2Feature3En    String @default("✔ Weekly meal plan with an automatic shopping list")

