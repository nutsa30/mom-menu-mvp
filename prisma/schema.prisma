generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  FREE
  RECIPE_PLAN
  FULL_PLAN
  CANCELED
}
enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AgeGroup {
  FROM_6
  FROM_9
  FROM_12
  FROM_24
}

enum IngredientType {
  FRUIT
  VEGETABLE
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum CancellationReason {
  PRICE
  NOT_NEEDED
  NOT_USED_ENOUGH
  MISSING_FEATURES
  DISLIKED_MENU
  TECHNICAL_ISSUE
  OTHER
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  passwordHash           String?
  googleId               String?            @unique
  role                   Role               @default(USER)
  subscriptionStatus     SubscriptionStatus @default(FREE)
  subscriptionStartedAt  DateTime?
  subscriptionCanceledAt DateTime?
  subscriptionRenewsAt   DateTime?
  lsCustomerId           String?
  lsSubscriptionId       String?            @unique

  qpSubscriptionToken    String?            @unique

  bogParentOrderId       String?            @unique
  trialEndsAt            DateTime?
  bogTrialUsed           Boolean            @default(false)
  billingIntervalMonths  Int?               // 1, 3, or 6 — which of the 3 trial-pricing tiers this account is billed on

  // Set the moment a renewal charge comes back "rejected" (see the BOG webhook's isFailed
  // branch) — blocks dashboard content access (see DashboardClient's isFullPlan) while
  // subscriptionStatus/subscriptionRenewsAt/bogParentOrderId stay untouched, so bog-renew's
  // daily cron keeps retrying the same saved card. Cleared the moment a renewal actually
  // captures (isPaid), which restores access automatically — no manual admin action needed
  // either way.
  paymentFailedAt        DateTime?

  isBlocked              Boolean            @default(false)
  isGifted               Boolean            @default(false)

  emailVerified          Boolean            @default(false)
  emailVerifyToken       String?            @unique

  pendingEmail           String?
  pendingEmailToken      String?            @unique

  promoCodeId            String?
  promoCode              PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  // ── Referral / promo-code program (per-user invite code, distinct from the admin
  // "PromoCode" model above) ────────────────────────────────────────────────────────
  // Permanent, auto-generated at registration, never regenerated. Deleting the account
  // deletes this row along with it via the normal account-delete flow — nothing extra
  // needed to "deactivate" it.
  referralCode           String?            @unique
  // Who invited this user — set at most once, the first time a valid code is redeemed,
  // and never changed afterwards (enforced in application code, not just here).
  referredByUserId       String?
  referredByUser         User?              @relation("Referrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals              User[]             @relation("Referrals")
  // Set once, the moment this user's first-ever SUCCESS payment is processed — the exact
  // instant that decides the referral discount/credit for good. Recurring renewals never
  // touch this again, which is what keeps them from re-earning the owner a second reward.
  referralFirstPaymentAt DateTime?

  creditLedgerAsOwner    CreditLedgerEntry[] @relation("CreditLedgerOwner")
  creditLedgerAsReferred CreditLedgerEntry[] @relation("CreditLedgerReferred")

  children               Child[]
  mealPlans              MealPlan[]
  passwordResetTokens    PasswordResetToken[]
  testimonials           Testimonial[]
  payments               Payment[]
  cancellations          SubscriptionCancellation[]

  // Real usage signal, distinct from subscription/billing dates — updated (throttled to
  // once per ~15min) by /api/heartbeat, called once whenever the dashboard actually loads.
  // Works identically whether opened in a normal browser tab or an installed home-screen
  // PWA (it's just a plain fetch to our own backend), unlike GA/GTM which can silently miss
  // standalone PWA sessions — so admin/analytics' "active users" count doesn't undercount
  // the parents who use Mommenu only from their home-screen icon.
  lastActiveAt           DateTime?

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

// One row per cancel-button click, kept even across a later re-subscribe/cancel cycle —
// this is the history admin/cancellations reads to see who canceled, when, and why.
model SubscriptionCancellation {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan       SubscriptionStatus  // which plan (RECIPE_PLAN/FULL_PLAN) they were on when they canceled
  reason     CancellationReason
  reasonText String?             // free text — required by the API when reason is OTHER

  createdAt  DateTime            @default(now())
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan             SubscriptionStatus
  status           PaymentStatus      @default(SUCCESS)

  bogOrderId       String             @unique
  cardType         String?
  billingIntervalMonths Int?          // 1, 3, or 6 — which trial-pricing tier this payment was for

  grossAmount      Float
  commissionAmount Float?
  netAmount        Float?

  // ── Referral program adjustments on this specific payment ──────────────────────
  // Both are implemented as a partial BOG refund issued right after this payment
  // captures (BOG's recurring-charge API always inherits the parent order's original
  // amount, so the discounted/reduced amount can't be charged directly — see lib/referral.ts).
  discountAmount       Float?   // 10% first-payment referral discount refunded to THIS (referred) user
  discountRefundFailed Boolean  @default(false)
  creditAppliedAmount  Float?   // this user's OWN referral-credit balance refunded back to them
  creditRefundFailed   Boolean  @default(false)

  creditEarnedFrom CreditLedgerEntry[] @relation("CreditSourcePayment")
  creditAppliedTo  CreditLedgerEntry[] @relation("CreditAppliedPayment")

  createdAt        DateTime           @default(now())
}

enum CreditLedgerType {
  EARNED
  USED
  REVERSED
}

// Full audit trail of every referral-credit movement (see lib/referral.ts for the logic
// that writes these). Owner's available balance at any moment = SUM(amount) over all of
// that owner's rows here.
//   EARNED   — a referred user's first-ever successful payment credited the owner +1.70₾.
//   USED     — credit consumed against the owner's OWN successful payment (refunded back
//              to the owner as part of that payment, see Payment.creditAppliedAmount).
//   REVERSED — a referral canceled their subscription after having earned the owner
//              credit, so that specific 1.70₾ is backed out of the owner's balance.
model CreditLedgerEntry {
  id               String            @id @default(cuid())
  ownerId          String
  owner            User              @relation("CreditLedgerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Which referral this movement is about — null for USED, which draws from the pooled
  // balance rather than one specific referral.
  referredUserId   String?
  referredUser     User?             @relation("CreditLedgerReferred", fields: [referredUserId], references: [id], onDelete: SetNull)
  type             CreditLedgerType
  amount           Float             // +1.70 (EARNED), negative (USED / REVERSED)
  sourcePaymentId  String?           // the referred user's payment that triggered EARNED/REVERSED
  sourcePayment    Payment?          @relation("CreditSourcePayment", fields: [sourcePaymentId], references: [id], onDelete: SetNull)
  appliedPaymentId String?           // the owner's own payment a USED entry was refunded against
  appliedPayment   Payment?          @relation("CreditAppliedPayment", fields: [appliedPaymentId], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime          @default(now())

  @@index([ownerId])
  @@index([referredUserId])
}

model PromoCode {
  id              String             @id @default(cuid())
  code            String             @unique
  planType        SubscriptionStatus
  discountPercent Int                @default(0)
  maxUses         Int?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  users           User[]
}

model Child {
  id        String   @id @default(cuid())
  name      String
  birthDate DateTime
  ageGroup  AgeGroup
  allergies String[] @default([])
  dislikes  String[] @default([])
  likes     String[] @default([])

  // Milk tracking
  milkType    String  @default("BREAST") // BREAST | FORMULA | BOTH | NONE
  milkStopped Boolean @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealPlans              MealPlan[]
  dailyLogs              DailyLog[]
  foodIntroductions      FoodIntroduction[]
  babyIngredientStatuses BabyIngredientStatus[]
  babyMealLogs           BabyMealLog[]
  dishVotes              DishVote[]
  extraFoodLogs          ExtraFoodLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoodIntroduction {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  foodName  String           // e.g. "გოგრა"
  startedAt DateTime         @default(now())
  status    String           @default("INTRODUCING") // INTRODUCING | SAFE | ALLERGIC
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId])
}

model Dish {
  id            String   @id @default(cuid())
  titleKa       String
  titleEn       String
  descriptionKa String
  descriptionEn String
  imageUrl      String?

  ingredientsKa String[]
  ingredientsEn String[]

  calories      Int?
  proteinGrams  Int?

  ironMg        Float?
  calciumMg     Float?
  vitaminCmg    Float?
  vitaminAmcg   Float?
  vitaminDmcg   Float?
  vitaminEmg    Float?
  vitaminKmcg   Float?
  vitaminB1mg   Float?
  vitaminB2mg   Float?
  vitaminB6mg   Float?
  vitaminB12mcg Float?
  folateMcg     Float?
  zincMg        Float?
  potassiumMg   Float?
  magnesiumMg   Float?
  phosphorusMg  Float?
  sodiumMg      Float?
  fiberGrams    Float?
  fatGrams      Float?
  carbsGrams    Float?
  omega3Mg      Float?

  ageGroups     AgeGroup[]
  allergens     String[] @default([])
  mealType      MealType @default(BREAKFAST)

  blwNoteKa     String?
  blwNoteEn     String?
  pureeNoteKa   String?
  pureeNoteEn   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  planItems     MealPlanItem[]
  dailyLogs     DailyLog[]
  votes         DishVote[]
  originalFor   DailyLog[] @relation("DailyLogOriginalDish")
  extraFoodLogs ExtraFoodLog[]
}

// "+ დაამატე რაც ჭამა" — food the child ate that Mommenu never planned (a grandparent's
// snack, anything off-menu). Kept as its OWN table rather than crammed into DailyLog,
// because DailyLog is strictly one row per (child, date, mealType) — the real slot the
// day's plan occupies — and this is explicitly food OUTSIDE any planned slot; reusing
// that unique constraint here would either collide with the real slot's row or force
// relaxing a constraint half the app depends on. It still points at the SAME Dish/
// Ingredient catalog DailyLog does (so nutrition data isn't duplicated anywhere), and
// /api/nutrition sums it into the exact same vitamin/nutrient totals as planned meals —
// one calculation, two sources, not two calculations.
model ExtraFoodLog {
  id           String      @id @default(cuid())
  date         String      // YYYY-MM-DD — same convention as DailyLog.date
  childId      String
  child        Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  dishId       String?
  dish         Dish?       @relation(fields: [dishId], references: [id], onDelete: SetNull)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  note         String?     // free text when nothing in the catalog matches (no nutrition data then)

  createdAt    DateTime    @default(now())

  @@index([childId, date])
}

// One row per (dish, child) — records whether that child's parent marked the dish liked
// ("ჭამა") or disliked ("არ მოეწონა"). Deliberately independent of DailyLog, whose dishId
// can later be swapped to a replacement dish ("სხვა") — the vote must stay pinned to the
// original dish it was cast for, not silently move to whatever dish ends up in that slot.
model DishVote {
  id        String   @id @default(cuid())
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  liked     Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dishId, childId])
}

model MealPlan {
  id        String   @id @default(cuid())
  titleKa   String
  titleEn   String
  ageGroup  AgeGroup
  dayOffset Int      @default(0)
  isActive  Boolean  @default(true)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  childId   String?
  child     Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     MealPlanItem[]
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealType   MealType
  sortOrder  Int      @default(0)
  notesKa    String?
  notesEn    String?

  mealPlanId String
  dishId     String

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id           String      @id @default(cuid())
  date         String      // YYYY-MM-DD
  childId      String
  child        Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  mealType     MealType
  dishId       String?
  dish         Dish?       @relation(fields: [dishId], references: [id], onDelete: SetNull)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  wasEaten     Boolean     @default(false)

  // The dish ORIGINALLY planned for this slot, captured the first time it's replaced
  // (by "სხვა" or by "რა მაქვს სახლში?") and never overwritten again afterwards — so the
  // chain "დაგეგმილი → ჩანაცვლებული → ნაჭამი" stays readable even after multiple swaps.
  originalDishId String?
  originalDish   Dish?      @relation("DailyLogOriginalDish", fields: [originalDishId], references: [id], onDelete: SetNull)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([childId, date, mealType])
}

model Ingredient {
  id            String         @id @default(cuid())
  titleKa       String
  titleEn       String
  type          IngredientType @default(FRUIT)
  imageUrl      String?
  ageGroups     AgeGroup[]
  seasons       Season[]       @default([])

  calories      Int?
  proteinGrams  Float?
  carbsGrams    Float?
  fatGrams      Float?
  fiberGrams    Float?
  ironMg        Float?
  calciumMg     Float?
  zincMg        Float?
  potassiumMg   Float?
  magnesiumMg   Float?
  phosphorusMg  Float?
  sodiumMg      Float?
  vitaminAmcg   Float?
  vitaminCmg    Float?
  vitaminDmcg   Float?
  vitaminEmg    Float?
  vitaminKmcg   Float?
  vitaminB1mg   Float?
  vitaminB2mg   Float?
  vitaminB6mg   Float?
  vitaminB12mcg Float?
  folateMcg     Float?
  omega3Mg      Float?

  benefitsKa    String[]       @default([])
  benefitsEn    String[]       @default([])

  dailyLogs     DailyLog[]
  extraFoodLogs ExtraFoodLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Blog {
  id          String   @id @default(cuid())
  titleKa     String
  titleEn     String
  contentKa   String
  contentEn   String
  slug        String?  @unique
  imageUrl    String?
  images      String[] @default([])
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HowItWorksSettings {
  id             String   @id @default("singleton")
  heroTitleKa    String   @default("სამი წუთი — და კვირის მენიუ მზადაა")
  heroTitleEn    String   @default("Three minutes and your weekly menu is ready")
  heroSubtitleKa String   @default("mom menu იღებს შვილის ინფორმაციას და შენ ნაცვლად ადგენს ყოველდღიურ, ბალანსირებულ კვების გეგმას.")
  heroSubtitleEn String   @default("mom menu takes your child's info and builds a balanced daily meal plan so you don't have to.")
  ctaTitleKa     String   @default("მზად ხარ?")
  ctaTitleEn     String   @default("Ready to get started?")
  ctaSubtitleKa  String   @default("პირველი კვირა — უფასოდ.")
  ctaSubtitleEn  String   @default("Your first week — on us.")
  updatedAt      DateTime @updatedAt
}

model HowItWorksStep {
  id        String   @id @default(cuid())
  icon      String   @default("🍽️")
  titleKa   String
  titleEn   String
  descKa    String
  descEn    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HowItWorksFaq {
  id         String   @id @default(cuid())
  questionKa String
  questionEn String
  answerKa   String
  answerEn   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

