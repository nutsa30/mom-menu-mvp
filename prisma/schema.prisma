generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  FREE
  RECIPE_PLAN
  FULL_PLAN
  CANCELED
}
enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AgeGroup {
  FROM_6
  FROM_9
  FROM_12
  FROM_24
}

enum IngredientType {
  FRUIT
  VEGETABLE
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  passwordHash           String?
  googleId               String?            @unique
  role                   Role               @default(USER)
  subscriptionStatus     SubscriptionStatus @default(FREE)
  subscriptionStartedAt  DateTime?
  subscriptionCanceledAt DateTime?
  subscriptionRenewsAt   DateTime?
  lsCustomerId           String?
  lsSubscriptionId       String?            @unique

  isBlocked              Boolean            @default(false)
  isGifted               Boolean            @default(false)

  emailVerified          Boolean            @default(false)
  emailVerifyToken       String?            @unique

  pendingEmail           String?
  pendingEmailToken      String?            @unique

  promoCodeId            String?
  promoCode              PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  children               Child[]
  mealPlans              MealPlan[]
  passwordResetTokens    PasswordResetToken[]

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model PromoCode {
  id              String             @id @default(cuid())
  code            String             @unique
  planType        SubscriptionStatus
  discountPercent Int                @default(0)
  maxUses         Int?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  users           User[]
}

model Child {
  id        String   @id @default(cuid())
  name      String
  birthDate DateTime
  ageGroup  AgeGroup
  allergies String[] @default([])
  dislikes  String[] @default([])
  likes     String[] @default([])

  // Milk tracking
  milkType    String  @default("BREAST") // BREAST | FORMULA | BOTH | NONE
  milkStopped Boolean @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealPlans              MealPlan[]
  dailyLogs              DailyLog[]
  foodIntroductions      FoodIntroduction[]
  babyIngredientStatuses BabyIngredientStatus[]
  babyMealLogs           BabyMealLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoodIntroduction {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  foodName  String           // e.g. "გოგრა"
  startedAt DateTime         @default(now())
  status    String           @default("INTRODUCING") // INTRODUCING | SAFE | ALLERGIC
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId])
}

model Dish {
  id            String   @id @default(cuid())
  titleKa       String
  titleEn       String
  descriptionKa String
  descriptionEn String
  imageUrl      String?

  ingredientsKa String[]
  ingredientsEn String[]

  calories      Int?
  proteinGrams  Int?

  ironMg        Float?
  calciumMg     Float?
  vitaminCmg    Float?
  vitaminAmcg   Float?
  vitaminDmcg   Float?
  vitaminEmg    Float?
  vitaminKmcg   Float?
  vitaminB6mg   Float?
  vitaminB12mcg Float?
  folateMcg     Float?
  zincMg        Float?
  potassiumMg   Float?
  magnesiumMg   Float?
  phosphorusMg  Float?
  sodiumMg      Float?
  fiberGrams    Float?
  fatGrams      Float?
  carbsGrams    Float?
  omega3Mg      Float?

  ageGroups     AgeGroup[]
  allergens     String[] @default([])
  mealType      MealType @default(BREAKFAST)

  blwNoteKa     String?
  blwNoteEn     String?
  pureeNoteKa   String?
  pureeNoteEn   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  planItems     MealPlanItem[]
  dailyLogs     DailyLog[]
}

model MealPlan {
  id        String   @id @default(cuid())
  titleKa   String
  titleEn   String
  ageGroup  AgeGroup
  dayOffset Int      @default(0)
  isActive  Boolean  @default(true)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  childId   String?
  child     Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     MealPlanItem[]
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealType   MealType
  sortOrder  Int      @default(0)
  notesKa    String?
  notesEn    String?

  mealPlanId String
  dishId     String

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id           String      @id @default(cuid())
  date         String      // YYYY-MM-DD
  childId      String
  child        Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  mealType     MealType
  dishId       String?
  dish         Dish?       @relation(fields: [dishId], references: [id], onDelete: SetNull)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  wasEaten     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([childId, date, mealType])
}

model Ingredient {
  id            String         @id @default(cuid())
  titleKa       String
  titleEn       String
  type          IngredientType @default(FRUIT)
  imageUrl      String?
  ageGroups     AgeGroup[]
  seasons       Season[]       @default([])

  calories      Int?
  proteinGrams  Float?
  carbsGrams    Float?
  fatGrams      Float?
  fiberGrams    Float?
  ironMg        Float?
  calciumMg     Float?
  zincMg        Float?
  potassiumMg   Float?
  magnesiumMg   Float?
  phosphorusMg  Float?
  sodiumMg      Float?
  vitaminAmcg   Float?
  vitaminCmg    Float?
  vitaminDmcg   Float?
  vitaminEmg    Float?
  vitaminKmcg   Float?
  vitaminB6mg   Float?
  vitaminB12mcg Float?
  folateMcg     Float?
  omega3Mg      Float?

  benefitsKa    String[]       @default([])
  benefitsEn    String[]       @default([])

  dailyLogs     DailyLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Blog {
  id          String   @id @default(cuid())
  titleKa     String
  titleEn     String
  contentKa   String
  contentEn   String
  slug        String?  @unique
  imageUrl    String?
  images      String[] @default([])
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HowItWorksSettings {
  id             String   @id @default("singleton")
  heroTitleKa    String   @default("სამი წუთი — და კვირის მენიუ მზადაა")
  heroTitleEn    String   @default("Three minutes and your weekly menu is ready")
  heroSubtitleKa String   @default("mom menu იღებს შვილის ინფორმაციას და შენ ნაცვლად ადგენს ყოველდღიურ, ბალანსირებულ კვების გეგმას.")
  heroSubtitleEn String   @default("mom menu takes your child's info and builds a balanced daily meal plan so you don't have to.")
  ctaTitleKa     String   @default("მზად ხარ?")
  ctaTitleEn     String   @default("Ready to get started?")
  ctaSubtitleKa  String   @default("პირველი კვირა — უფასოდ.")
  ctaSubtitleEn  String   @default("Your first week — on us.")
  updatedAt      DateTime @updatedAt
}

model HowItWorksStep {
  id        String   @id @default(cuid())
  icon      String   @default("🍽️")
  titleKa   String
  titleEn   String
  descKa    String
  descEn    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HowItWorksFaq {
  id         String   @id @default(cuid())
  questionKa String
  questionEn String
  answerKa   String
  answerEn   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

